# Copy to .env and edit. .env is git-ignored (SEC-4); these are dummy defaults.

# "production" restricts CORS to CORS_ORIGINS and hides unexpected job errors.
APP_ENV=development
# Comma-separated origins allowed to call the API cross-site, e.g. https://ui.example.com
CORS_ORIGINS=
PORT=5000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100
UPLOAD_TTL_SECONDS=3600
UPLOAD_DIR_MAX_MB=500

# Jobs
JOB_TTL_SECONDS=3600

# Models
SVM_MAX_ROWS=20000
DNN_EPOCHS=100
QML_MAX_ROWS=2000
QML_EPOCHS=20
QML_QUBITS=4
# default.qubit (fast, batched), lightning.qubit, or lightning.gpu (Linux, requirements-gpu.txt)
QML_DEVICE=default.qubit
# auto (NVIDIA GPU for XGBoost and the DNN when CUDA is usable) or cpu
COMPUTE_DEVICE=auto
